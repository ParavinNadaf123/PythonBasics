Better: Keep Both in One Program

For your practice project, I recommend this arrangement:

from pathlib import Path


# ==========================================================
# PATH CONFIGURATION
# ==========================================================

BASE_DIR = Path(__file__).resolve().parent

LOG_FILE = BASE_DIR / "logs" / "automation.log"
REPORT_DIR = BASE_DIR / "reports"

SUMMARY_REPORT = REPORT_DIR / "test_report.txt"
FAILED_TESTS_FILE = REPORT_DIR / "failed_tests.txt"


# Create reports folder
REPORT_DIR.mkdir(exist_ok=True)


# ==========================================================
# GENERATE SUMMARY REPORT
# ==========================================================

def generate_summary_report():

    pass_count = 0
    fail_count = 0

    with open(LOG_FILE, "r") as file:

        for line in file:

            if " - PASS" in line:
                pass_count += 1

            elif " - FAIL" in line:
                fail_count += 1

    total_tests = pass_count + fail_count

    report = (
        "TEST EXECUTION SUMMARY\n"
        "======================\n"
        f"Total Test Cases : {total_tests}\n"
        f"PASS             : {pass_count}\n"
        f"FAIL             : {fail_count}\n"
    )

    with open(SUMMARY_REPORT, "w") as file:
        file.write(report)

    print(report)


# ==========================================================
# STORE FAILED TEST CASES
# ==========================================================

def store_failed_tests():

    with open(LOG_FILE, "r") as log_file, \
         open(FAILED_TESTS_FILE, "w") as failed_file:

        for line in log_file:

            if " - FAIL" in line:

                parts = line.strip().split(" - ")

                test_id = parts[2]
                test_name = parts[3]

                failed_file.write(
                    f"{test_id} - {test_name}\n"
                )

    print("Failed test cases stored successfully.")


# ==========================================================
# MAIN
# ==========================================================

if __name__ == "__main__":

    generate_summary_report()

    store_failed_tests()
