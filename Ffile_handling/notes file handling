2. Store Failed Test Case Names in a Separate File
Approach
Open automation.log.
Read each line.
Find lines containing FAIL.
Extract the test case ID and name.
Write them to failed_tests.txt.
Code
def store_failed_tests():

    failed_tests = []

    # Read automation log
    with open(LOG_FILE, "r") as file:

        for line in file:

            if " - FAIL" in line:

                # Example:
                # 2026-08-08 10:15:22 - ERROR - TC003 - Search Test - FAIL

                parts = line.strip().split(" - ")

                test_id = parts[2]
                test_name = parts[3]

                failed_tests.append(
                    f"{test_id} - {test_name}"
                )

    # Write failed tests
    with open(REPORT_DIR / "failed_tests.txt", "w") as file:

        for test in failed_tests:
            file.write(test + "\n")

    print("Failed test cases stored successfully.")


store_failed_tests()
