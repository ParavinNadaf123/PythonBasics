1. Generate Summary Report — PASS & FAIL
Approach
Open automation.log.
Read the file line by line.
Check for PASS.
Check for FAIL.
Increase the respective counter.
Calculate total test cases.
Write the result to test_report.txt.
Code
from pathlib import Path


# Project paths
BASE_DIR = Path(__file__).resolve().parent

LOG_FILE = BASE_DIR / "logs" / "automation.log"
REPORT_DIR = BASE_DIR / "reports"
REPORT_FILE = REPORT_DIR / "test_report.txt"


# Create reports folder
REPORT_DIR.mkdir(exist_ok=True)


def generate_summary_report():

    pass_count = 0
    fail_count = 0

    # Read automation log
    with open(LOG_FILE, "r") as file:

        for line in file:

            if " - PASS" in line:
                pass_count += 1

            elif " - FAIL" in line:
                fail_count += 1

    total_tests = pass_count + fail_count

    # Create report
    report = (
        "TEST EXECUTION SUMMARY\n"
        "======================\n"
        f"Total Test Cases : {total_tests}\n"
        f"PASS             : {pass_count}\n"
        f"FAIL             : {fail_count}\n"
    )

    # Write report
    with open(REPORT_FILE, "w") as file:
        file.write(report)

    print(report)


generate_summary_report()
